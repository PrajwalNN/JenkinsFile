pipeline {
    agent any

    stages {
        stage('checkout') {
            steps {
                git branch: 'master', url: 'https://github.com/PrajwalNN/JenkinsFile.git'
            }
        }

        stage('build') {
            steps {
                echo "building"
            }
        }

        stage('test') {
            steps {
                echo "testing"
            }
        }
    }
}
